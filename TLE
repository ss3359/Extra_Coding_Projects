# Invalid TLE Examples for Testing

#include <algorithm>
#include <cctype>
#include <charconv>
#include <cmath>
#include <iostream>
#include <string_view>

constexpr double MU_EARTH = 398600.4418;  // km³/s² (Earth’s gravitational parameter)
constexpr double R_EARTH = 6378.137;      // km (Earth’s equatorial radius)

constexpr std::size_t LINE_LEN = 69;  // Every TLE line must be exactly 69 chars

// Column indices (0‑based) – see the official TLE format specification
enum : std::size_t {
    COL_CATALOG_START = 2,
    COL_CATALOG_LEN = 5,
    COL_INCL_START = 8,
    COL_INCL_LEN = 8,
    COL_ECC_START = 26,
    COL_ECC_LEN = 7,
    COL_MEANMO_START = 52,
    COL_MEANMO_LEN = 11,
    COL_CHECKSUM_POS = 68
};

// This is a helper function to eliminate whitespace from a string, which is useful for parsing TLE fields that may be
// right-aligned with spaces.
static std::string trimSpaces(const std::string& line)
{
    std::string out;
    out.reserve(line.size());
    for (char c : line)
    {
        if (!std::isspace(static_cast<unsigned char>(c)))
        {
            out.push_back(c);
        }
    }
    return out;
}

static int calculateChecksum(std::string line)
{
    int sum = 0;
    for (std::size_t i = 0; i < COL_CHECKSUM_POS; ++i)
    {
        char ch = line[i];
        if (std::isdigit(static_cast<unsigned char>(ch)))
        {
            sum += ch - '0';
        }
        else if (ch == '-')
        {
            ++sum;  // a minus sign counts as 1
        }
    }
    return sum % 10;
}

static double parseEccentricity(const std::string& line2)
{
    constexpr std::size_t end = COL_ECC_START + COL_ECC_LEN;
    if (line2.size() < end)
    {
        throw std::invalid_argument("Eccentricity field truncated (line 2).");
    }

    std::string eccSv = line2.substr(COL_ECC_START, COL_ECC_LEN);
    if (!std::all_of(eccSv.begin(), eccSv.end(), [](unsigned char c) { return std::isdigit(c); }))
    {
        throw std::invalid_argument("Eccentricity contains non-digit characters.");
    }

    uint64_t intVal = 0;
    auto [ptr, ec] = std::from_chars(eccSv.data(), eccSv.data() + eccSv.size(), intVal);
    if (ec != std::errc())
    {
        throw std::invalid_argument("Failed to convert eccentricity to integer.");
    }

    double e = static_cast<double>(intVal) / 1'000'000.0;  // 7‑digit integer → fraction
    if (e <= 0.0 || e >= 1.0)
    {
        throw std::invalid_argument("Eccentricity out of range (0-1).");
    }
    return e;
}

static double parseMeanMotion(const std::string& line2)
{
    constexpr std::size_t end = COL_MEANMO_START + COL_MEANMO_LEN;
    if (line2.size() < end)
    {
        throw std::invalid_argument("Mean-motion field truncated (line 2).");
    }

    // Trim leading/trailing blanks – the TLE field may be right‑aligned.
    std::string meanMotionStr = trimSpaces(line2.substr(COL_MEANMO_START, COL_MEANMO_LEN));
    double meanMotion = std::stod(meanMotionStr);
    if (meanMotion <= 0.0)
    {
        throw std::invalid_argument("Mean motion must be positive.");
    }
    return meanMotion;
}

static double revPerDayToRadPerSec(double revPerDay) noexcept { return revPerDay * 2.0 * M_PI / 86400.0; }

static double revPerDayToSemiMajorAxis(double revPerDay)
{
    double n = revPerDayToRadPerSec(revPerDay);
    // a = (μ / n²)^(1/3)
    return std::cbrt(MU_EARTH / (n * n));
}

static bool validateTLEOrbit(const std::string& line1, const std::string& line2)
{
    // Test to see if length of each line is 69 characters, if not return false and print error message.
    if (line1.length() != LINE_LEN || line2.length() != LINE_LEN)
    {
        std::cerr << "One or both TLE lines are shorter (or larger) than 69 characters.\n";
        return false;
    }
    try
    {
        // Wrong Line Numbers
        if (line1.empty() || line2.empty() || line1[0] != '1' || line2[0] != '2')
        {
            throw std::invalid_argument("Line numbers are incorrect, line 1 should start with '1', line 2 with '2'.");
        }

        // Non-numeric Fields
        auto is_allowed = [](unsigned char c) {
            return std::isdigit(c)                      // 0‑9
                   || std::isspace(c)                   // space, tab, …
                   || c == '-' || c == '.' || c == '+'  // minus, decimal point
                   || std::isupper(c);                  // any A‑Z (covers U, A‑Q, etc.)
        };

        if (!std::all_of(line1.begin(), line1.end(), is_allowed))
        {
            throw std::invalid_argument("Line 1 contains illegal characters.");
        }
        if (!std::all_of(line2.begin(), line2.end(), is_allowed))
        {
            throw std::invalid_argument("Line 2 contains illegal characters.");
        }

        // Catalog numbers must match
        if (line1.substr(COL_CATALOG_START, COL_CATALOG_LEN) != line2.substr(COL_CATALOG_START, COL_CATALOG_LEN))
        {
            throw std::invalid_argument("Catalog numbers differ between lines.");
        }

        // Inclination must be between 0 and 180 degrees
        double inc = std::stod(trimSpaces(line2.substr(COL_INCL_START, COL_INCL_LEN)));
        if (inc < 0.0 || inc > 180.0)
        {
            throw std::invalid_argument("Inclination out of range (0-180°).");
        }

        // Checksums must match the calculated value:
        // Cheksum match line 1
        int expected1 = line1[COL_CHECKSUM_POS] - '0';
        int calc1 = calculateChecksum(line1);
        if (calc1 != expected1)
        {
            throw std::invalid_argument("Checksum mismatch on line 1");
        }

        // Cheksum match line 2
        int expected2 = line2[COL_CHECKSUM_POS] - '0';
        int calc2 = calculateChecksum(line2);
        if (calc2 != expected2)
        {
            throw std::invalid_argument("Checksum mismatch on line 2");
        }

        // Mean motion must be positive and correspond to a semi-major axis greater than Earth's radius
        double meanMotion = parseMeanMotion(line2);  // will throw if not a valid number or non-positive
        double a = revPerDayToSemiMajorAxis(meanMotion);
        if (a <= R_EARTH)
        {
            throw std::invalid_argument("Derived semi-major axis (" + std::to_string(a) +
                                        " km) is smaller than Earth's radius.");
        }

    } catch (const std::invalid_argument& e)
    {
        std::cerr << "Error: " << e.what() << '\n';
        return false;
    }
    return true;
}

int main()
{
   std::string line1 = "1 25544U 98067A   24045.51782528  .00016717  00000-0  10270-3 0  9991";
   std::string line2 = "2 25544 200.0000 247.4627 0006703 130.5360 325.0288 15.50012345234567";

    std::cout<<"Line1 length: "<<line1.length()<<std::endl;
    std::cout<<"Line2 length: "<<line2.length()<<std::endl;

    bool ok = validateTLEOrbit(line1, line2);
    if (ok)
    {
        std::cout << "TLE is valid.\n";
    }
    else
    {
        std::cout << "TLE is invalid.\n";
    }

    return 0;
}


